<?xml version="1.0" encoding="utf-8"?>
<!--
    Spool runs on a computer on the home network and speaks plain HTTP at a local address
    (e.g. 192.168.1.20), which Android 9+ blocks by default. Address ranges can't be listed
    here, so cleartext is allowed; everything that leaves the home network (cover lookups)
    uses HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
